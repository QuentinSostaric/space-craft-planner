# Copier ce fichier en .dev.vars (jamais commite)
# Le serveur API local lit directement les chunks depuis Cloudflare R2.

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<r2-dev-bucket-name>
R2_BUCKET_REGION=auto

# Optional Discord OAuth 2 foundation
# Register http://localhost:5173/api/auth/discord/callback in the Discord developer portal.
DISCORD_CLIENT_ID=<discord-client-id>
DISCORD_CLIENT_SECRET=<discord-client-secret>
AUTH_SESSION_SECRET=<long-random-secret>
AUTH_PUBLIC_ORIGIN=http://localhost:5173
DISCORD_BOT_WORKER_URL=<discord-bot-worker-url>
DISCORD_BOT_INTERNAL_TOKEN=<shared-secret-between-site-and-bot-worker>
# Optional overrides:
# DISCORD_OAUTH_SCOPES=identify
# DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Optional Citizen iD RSI link flow
# Register http://localhost:5173/api/auth/citizenid/callback in Citizen iD.
CITIZENID_CLIENT_ID=<citizenid-client-id>
CITIZENID_CLIENT_SECRET=<citizenid-client-secret>
# Optional overrides:
# CITIZENID_ORIGIN=<citizenid-origin>
# CITIZENID_OAUTH_SCOPES=openid rsi.profile
# CITIZENID_REDIRECT_URI=http://localhost:5173/api/auth/citizenid/callback
