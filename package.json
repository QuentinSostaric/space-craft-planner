{
  "name": "item-fabricator",
  "version": "2.4.4",
  "private": true,
  "description": "Item Fabricator \u2014 Star Citizen crafting simulator, dismantling calculator and resource planner.",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "predev": "node scripts/checkDevPorts.mjs",
    "prebuild": "node scripts/generateAgentArtifacts.mjs && node scripts/generateVersionFile.mjs",
    "dev": "concurrently -k -n vite,api -c blue,yellow \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:vite": "npm run dev --workspace client -- --port 5173 --strictPort",
    "dev:api": "node scripts/devApiServer.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release:check-version": "node scripts/validateReleaseVersion.mjs",
    "config:check": "node scripts/validateConfiguration.mjs",
    "cloudflare:check": "wrangler pages functions build functions --project-directory . --outdir .tmp/ci-pages --compatibility-date 2024-09-23 && wrangler deploy --dry-run --config workers/discord-bot/wrangler.toml --outdir .tmp/ci-wrangler-bot",
    "discord:bot:dev": "wrangler dev --config workers/discord-bot/wrangler.toml --port 8790",
    "discord:bot:deploy": "wrangler deploy --config workers/discord-bot/wrangler.toml",
    "discord:bot:register:guild": "node workers/discord-bot/scripts/register-commands.mjs guild",
    "discord:bot:register:global": "node workers/discord-bot/scripts/register-commands.mjs global",
    "test": "node --test tests/*.test.mjs",
    "test:client": "npm run test --workspace client",
    "test:e2e": "npm run test:e2e --workspace client",
    "typecheck": "npm run typecheck --workspace client",
    "ui:guard": "node scripts/checkUiArchitecture.mjs",
    "build": "npm run build --workspace client",
    "claims:org": "node scripts/manageOrganizationClaims.mjs",
    "planner:purge-goals": "node scripts/purgePlannerGoals.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "concurrently": "^10.0.5",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "dompurify": ">=3.4.13",
    "shell-quote": ">=1.9.0",
    "sharp": ">=0.35.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "react",
    "vite",
    "cloudflare-r2"
  ],
  "author": "TheSamon",
  "license": "MIT"
}
