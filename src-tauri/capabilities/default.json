{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["https://itemfab.space/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-fetch-api-json",
    "allow-start-desktop-oauth",
    "allow-clear-desktop-auth-session",
    "allow-detect-sc-install-paths",
    "allow-scan-blueprints-from-logs",
    "allow-start-log-watcher",
    "allow-stop-log-watcher",
    "allow-get-watcher-status",
    "allow-enable-auto-startup",
    "allow-disable-auto-startup",
    "allow-is-auto-startup-enabled"
  ]
}
