DISCORD_APPLICATION_ID=<discord-application-id>
DISCORD_PUBLIC_KEY=<discord-interactions-public-key>
DISCORD_BOT_TOKEN=<discord-bot-token>
DISCORD_BOT_INTERNAL_TOKEN=<shared-secret-between-site-and-bot-worker>
