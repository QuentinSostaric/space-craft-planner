# ─── MongoDB Atlas Data API ────────────────────────────────────────────────────
# Setup : Atlas UI → App Services → Create App → Data API → Enable
#
# 1. Copier l'URL complète de l'endpoint Data API de ton App Services
#    Format : https://data.mongodb-api.com/app/<APP-ID>/endpoint/data/v1
VITE_ATLAS_DATA_API_URL=mongodb+srv://SamAdmin:YEyHuH8tknmmQYyc@cluster42.unxousw.mongodb.net/?appName=Cluster42

# 2. Créer une API Key READ-ONLY dans App Services → Authentication → API Keys
#    Scoper la clé à craft/* en read-only uniquement
VITE_ATLAS_API_KEY=YOUR-READ-ONLY-API-KEY

# ─── Paramètres MongoDB (valeurs par défaut si non renseignées) ────────────────
# Nom du cluster tel qu'il apparaît dans Atlas (onglet Data Sources)
VITE_ATLAS_DATA_SOURCE=Cluster42

# Nom de la base de données
VITE_ATLAS_DB_NAME=craft

# Collections (doivent correspondre à celles créées par importToMongo.mjs)
VITE_ATLAS_LIVE_COLLECTION=craft-live-data
VITE_ATLAS_PTU_COLLECTION=craft-ptu-data
